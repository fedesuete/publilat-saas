# WAHA con parche de PAÍS en el handshake de Baileys.
#
# POR QUÉ: el Baileys embebido en WAHA declara el país HARDCODEADO como "US" en el payload de login
# (Defaults `countryCode: 'US'`; lo usa validate-connection.js -> localeCountryIso31661Alpha2). El motor
# NOWEB de WAHA nunca lo setea (solo WEBJS lo referencia), así que TODAS nuestras líneas +54 se
# presentaban ante WhatsApp diciendo "soy de Estados Unidos": SIM argentina + handshake US = mismatch
# geo sistemático a nivel protocolo (confirmado 2026-08-15; el pool de proxies no lo arregla).
#
# QUÉ HACE: deriva de la imagen pineada y cambia el default a 'AR'. El grep final ROMPE el build si una
# imagen nueva de WAHA cambia la ruta o la forma del default (mejor fallar fuerte en el build que volver
# a "US" en silencio). Al actualizar WAHA (deploy/update-waha.sh) el parche se re-aplica solo porque el
# compose construye SIEMPRE desde este Dockerfile.
ARG WAHA_BASE=devlikeapro/waha@sha256:dc134637dfa0bd65202010a65e4ff8176101791699176c75bb37d5aa9daf487c
FROM ${WAHA_BASE}
RUN sed -i "s/countryCode: 'US'/countryCode: 'AR'/g" /app/node_modules/@adiwajshing/baileys/lib/Defaults/index.js \
 && grep -q "countryCode: 'AR'" /app/node_modules/@adiwajshing/baileys/lib/Defaults/index.js

# Miniatura de IMÁGENES (2026-10-10): el sharp de la imagen trae un binario compilado en src/build que NO
# coincide con su JS (falla toda miniatura con "vips_colourspace: no known route from 'srgb' to 'last'").
# Sin miniatura Baileys no manda ancho/alto y WhatsApp muestra la foto RECORTADA en un cuadrado. Sacando
# ese build, sharp usa su binario prebuilt correcto. La prueba final ROMPE el build si vuelve a fallar.
RUN rm -rf /app/node_modules/sharp/src/build \
 && cd /app && node -e "require('sharp')({create:{width:40,height:20,channels:3,background:'#fff'}}).jpeg().toBuffer().then(b=>require('sharp')(b).resize(32).jpeg({quality:50}).toBuffer()).then(()=>console.log('sharp OK')).catch(e=>{console.error('sharp ROTO',e.message);process.exit(1)})"
