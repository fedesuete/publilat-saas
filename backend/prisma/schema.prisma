// Publi.lat — esquema de datos
// El modelo cubre el loop de atribución completo + líneas, tokens y landings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  slug      String   @unique          // identifica al usuario en /go?u=<slug>
  password  String
  name      String?
  phone     String?                    // WhatsApp del usuario (registro)
  paymentDetection String @default("auto") // off | assisted | auto — lector de comprobantes (default auto)
  // Embudo de eventos a Meta: si true, el Lead se dispara en el 1er INBOUND real (no en el clic).
  // Default false = comportamiento de hoy (Lead en el clic). Se prende por cuenta (ON para victor).
  leadOnInbound    Boolean @default(false)
  // --- Panel maestro (super-admin) ---
  role          Role      @default(USER)
  suspended     Boolean   @default(false)
  isDemo        Boolean   @default(false)
  demoExpiresAt DateTime?
  source        String?                    // cómo llegó la cuenta (demo, referido, etc.)
  lastLoginAt   DateTime?
  // --- Referidos: 10% de la PRIMERA compra del referido, pagado en USDT a mano por el admin.
  // Solo clientes existentes (con ≥1 compra aprobada) pueden referir. Ver lib/referrals.ts. ---
  referralCode  String?   @unique          // código propio para compartir (/register?ref=CODE)
  referredById  String?                    // quién refirió a esta cuenta (User.id del referidor)
  // --- Límites de plan (configurables por cliente desde el panel) ---
  maxLines      Int       @default(5)        // líneas de WhatsApp permitidas (5 por defecto; más = soporte)
  maxLandings   Int       @default(50)       // landings permitidas
  maxAudioClips Int       @default(2)        // audios en la biblioteca (el admin no tiene tope)
  tokenVersion  Int       @default(0)        // revocación de sesiones: al subir, invalida los JWT viejos
  // --- Landings aisladas en S3+CloudFront (anti-quemado, modelo ScaleOS) ---
  // Cada cliente tiene su PROPIA distribución CloudFront (dominio descartable): si Meta
  // quema una landing, cae solo ese dominio, no publi.lat ni los otros clientes.
  s3Prefix        String?   // carpeta del cliente en el bucket (default = slug)
  cloudfrontDomain String?  // dominio de la distribución del cliente (ej d50ti8s.cloudfront.net)
  cloudfrontDistId String?  // id de la distribución (para invalidar / reprovisionar)
  // --- Chat App (canal jugador↔cajero, módulo aislado): marca white-label por cuenta ---
  brandName       String?
  logoUrl         String?
  notifSoundUrl   String?   // sonido custom del panel al llegar un mensaje nuevo (URL de un BrandingAsset)
  casinoApiKey    String?   // API key del partner-api del casino de ESTA cuenta (cifrada). Si está, la
                            // cuenta opera su propio tenant; si no, cae a la key global del .env (legacy).
  primaryColor    String?
  accentColor     String?
  chatTheme       String    @default("whatsapp") // diseño de la PWA del chat: whatsapp | midnight | redblack (WhatsApp pelado, sin botones)
  welcomeText     String?   // texto de bienvenida en la PWA
  welcomeMsgText  String?   // primer mensaje automático de la conversación
  welcomeMsgImage String?
  chatWaLink      String?   // link wa.me para el CTA "Escribinos por WhatsApp" (registro un-tap)
  chatPlatformUrl String?   // link a la plataforma de juego (botón "Entrar a la plataforma" + 1er msg)
  chatPayCbu      String?   // datos de pago estructurados (botones copiar individual en el cajero)
  chatPayAlias    String?
  chatPayTitular  String?
  chatInstallMsg1 String?   // secuencia de instalación (mensajes guardados que el operador envía)
  chatInstallMsg2 String?   // el 2do lleva botón "INSTALAR APP" en la PWA
  chatInstallMsg3 String?
  chatTutIosImg     String? // foto tutorial de instalación iPhone, paso 1 (URL /branding/asset/:id)
  chatTutIosImg2    String? // foto tutorial iPhone, paso 2
  chatTutIosImg3    String? // foto tutorial iPhone, paso 3
  chatTutIosImg4    String? // foto tutorial iPhone, paso 4
  chatTutAndroidImg String? // foto tutorial de instalación Android
  chatDirectWelcome String? // 1er mensaje del "chat directo" (/c/:slug, sin registro): pide el nombre
  chatInstallPromptEnabled Boolean @default(false) // muestra el cartel "Instalá la app" dentro del chat
  chatNotifTitle  String?   // título del modal "Activá las notificaciones" (branded por cuenta; default neutro)
  chatNotifText   String?   // bajada del modal de notificaciones (branded por cuenta; default neutro)
  // Día de Chat App INDEPENDIENTE de WhatsApp: el cliente que no quiere/puede usar WhatsApp gasta
  // 1 día del saldo (mismo pool) y opera por el canal propio. Se auto-renueva 24h mientras esté
  // prendido y haya saldo (igual que las líneas). El Chat App se prende si hay línea WA con día
  // vigente O este día vigente.
  chatDayEnabled   Boolean   @default(false)
  chatDayExpiresAt DateTime?
  // Popup/promo que ve el jugador al entrar a la PWA (imagen + texto + link). popupUpdatedAt
  // versiona el aviso: el jugador lo ve de nuevo cada vez que cambia (dedupe en el cliente).
  popupActive     Boolean   @default(false)
  popupImageUrl   String?
  popupTitle      String?
  popupText       String?
  popupLink       String?
  popupFrom       DateTime? // ventana opcional: no se muestra antes de esta fecha/hora
  popupUntil      DateTime? // ni después de esta
  popupUpdatedAt  DateTime?
  // --- Bot de carga/descarga del Chat App (opcional, por cuenta; aislado, no toca WhatsApp) ---
  botEnabled     Boolean  @default(false)  // prende/apaga el bot para esta cuenta
  botPaymentInfo String?                   // datos de pago que muestra el bot (alias/CBU/QR/USDT del cliente)
  botWelcome     String?                   // saludo inicial del bot (opcional)
  botLoadWebhook String?                   // URL del sistema del socio para disparar la carga (Fase 3)
  // --- Saludo automático con botones para chats de anuncio (CTWA / Cloud API) ---
  waWelcomeEnabled Boolean @default(false) // prende el auto-saludo al entrar el 1er msg del anuncio
  waWelcomeText    String?                 // cuerpo del saludo (ej. "¡Hola! ¿Cómo podemos ayudarte?")
  waWelcomeButtons String?                 // hasta 3 botones, etiquetas separadas por "|"
  // Auto-responder con botón CTA (link) en la Cloud API: bienvenida al 1er msg + follow-up en cada
  // msg siguiente, con un botón que abre un URL (funnel neutro; el casino NO va en el texto).
  waAutoEnabled    Boolean @default(false)
  waAutoWelcome    String?                 // texto del 1er mensaje
  waAutoFollowup   String?                 // texto de los mensajes siguientes (ej. "Ya te pasamos el contacto 👇")
  waAutoBtnLabel   String?                 // etiqueta del botón (ej. "Hablar con Meli", ≤20 chars)
  waAutoBtnUrl     String?                 // URL del botón (wa.me, Chat App, o el link que sea)
  createdAt DateTime @default(now())

  lines       WaLine[]
  contacts    Contact[]
  landings    Landing[]
  pixels      Pixel[]
  events      MetaEvent[]
  credit      Credit?
  integration Integration?
  payments    Payment[]
  referralsMade Referral[] @relation("ReferralReferrer") // comisiones que ganó como referidor
  supportMessages SupportMessage[]
  quickReplies QuickReply[]
  audioClips  AudioClip[]
  notifications Notification[]
  flows       Flow[]
  // Chat App (módulo aislado)
  chatPlayers       ChatPlayer[]
  chatConversations ChatConversation[]
  chatMessages      ChatMessage[]
  inviteCodes       InviteCode[]
  chatPushSubs      ChatPushSub[]
  brandingAssets    BrandingAsset[]
  chatBroadcasts    ChatBroadcast[]
  casinoTxs         CasinoTx[]
  chatWallets       ChatWallet[]
  chatDeposits      ChatDeposit[]
  chatWithdrawals   ChatWithdrawal[]
}

// Carga/descarga contra la plataforma del socio (ganamos). Idempotencia y reversa por `referencia`,
// que es UNIQUE a nivel DB (el débito no hereda idempotencia; el UNIQUE evita el doble débito
// concurrente). El monto va ENTERO en la moneda del tenant (ARS), sin centavos.
model CasinoTx {
  id             String   @id @default(cuid())
  userId         String   // cuenta (tenant) de Publi
  conversationId String?  // conversación del chat que la originó
  playerId       String?
  type           String   // credit | debit
  usuario        String   // username del casino (ganamos)
  amount         Int      // entero en la moneda del tenant (ARS), sin centavos
  currency       String   @default("ARS")
  referencia     String   @unique // idempotency key end-to-end
  status         String   @default("pending") // pending | completed | failed | reversed
  txId           String?  // id de transacción que devuelve ganamos
  errorCode      String?  // code del error de ganamos (ej. player_not_found)
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// --- Cajero self-service del Chat App (Fase E). ARS entero (sin centavos). REGLA DURA: la
//     acreditación al wallet la habilita SOLO el operador aprobando, o un webhook de gateway REAL.
//     NUNCA por la imagen del comprobante sola. El Purchase CAPI se dispara SOLO al acreditar. ---
model ChatWallet {
  id        String   @id @default(cuid())
  userId    String   // cuenta (tenant)
  playerId  String   @unique // saldo por jugador
  balance   Int      @default(0) // ARS entero
  currency  String   @default("ARS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatDeposit {
  id              String    @id @default(cuid())
  userId          String
  playerId        String
  amount          Int       // ARS entero
  currency        String    @default("ARS")
  method          String    // método que eligió el jugador (transferencia/alias/etc.)
  comprobanteType String?   // mime de la imagen del comprobante (si subió)
  comprobanteData Bytes?    // bytes del comprobante — NO acredita por sí solo
  gatewayRef      String?   // referencia si vino por webhook de gateway real
  status          String    @default("pending") // pending | verified | credited | rejected
  purchaseFiredAt DateTime?  // cuándo se disparó el Purchase a Meta (idempotencia: 1 por carga).
                             // OJO: marketing a Meta ≠ acreditar fichas (eso sigue en approve/webhook).
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model ChatWithdrawal {
  id         String    @id @default(cuid())
  userId     String
  playerId   String
  amount     Int       // ARS entero
  currency   String    @default("ARS")
  destino    String    // CBU/CVU/alias del jugador
  status     String    @default("requested") // requested | approved | paid | rejected
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Automatización / secuencia (tipo ManyChat) para WhatsApp.
model Flow {
  id        String   @id @default(cuid())
  userId    String
  name      String
  enabled   Boolean  @default(false)
  trigger   String   @default("first_message") // first_message | keyword
  keyword   String?                            // si trigger = keyword
  steps     Json     // [{ id, type: "message"|"delay"|"wait_reply", text?, minutes? }]
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs      FlowRun[]

  @@index([userId])
}

// Link rastreado de una automatización: uno por (paso, contacto). Mide quién clickeó
// (estilo CTR de ManyChat). El código es el id (cuid) y se sirve en GET /r/:code.
model TrackedLink {
  id          String    @id @default(cuid())
  userId      String
  flowId      String?
  stepId      String?
  contactId   String?
  url         String
  label       String?
  clicks      Int       @default(0)
  lastClickAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([flowId, stepId])
}

// Estado de ejecución de una secuencia por contacto.
model FlowRun {
  id        String   @id @default(cuid())
  flowId    String
  contactId String
  stepIndex Int      @default(0)          // legacy (flujos lineales viejos)
  cursor    String   @default("0")        // posición en el árbol: "2" o "2:1:0" (paso:opción:subpaso)
  status    String   @default("running")  // running | waiting | waiting_option | done
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  flow      Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, status])
}

// Idempotencia de eventos entrantes de WhatsApp: el motor (sobre todo WAHA con
// message.any) puede entregar el MISMO mensaje dos veces casi simultáneas. Insertar
// aquí es atómico (key @unique): solo el primer evento procesa; el duplicado choca y
// se saltea, antes de crear contactos/mensajes. Evita leads duplicados por la carrera.
model InboundDedup {
  id        String   @id @default(cuid())
  key       String   @unique // "<instance>:<waMessageId>"
  createdAt DateTime @default(now())

  @@index([createdAt]) // para poder podar los viejos
}

// Notificaciones del usuario (nuevo lead, venta, línea caída, etc.).
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // lead | purchase | line_down | line_quality | system
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// Respuestas rápidas / mensajes guardados del Inbox (por usuario).
model QuickReply {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Biblioteca de audios reutilizables del Inbox (por usuario). Al enviarse, cada copia se
// "uniquifica" con ffmpeg (silencio/volumen/metadata al azar) para que no se detecte como el
// mismo archivo repetido. Límite maxAudioClips por cliente; el admin no tiene tope.
model AudioClip {
  id          String   @id @default(cuid())
  userId      String
  title       String
  contentType String   // audio/ogg | audio/webm | audio/mpeg …
  data        Bytes
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Hilo de soporte 1-a-1 entre cada cliente y el dueño (admin).
model SupportMessage {
  id        String   @id @default(cuid())
  userId    String
  fromAdmin Boolean  @default(false)
  body      String
  mediaUrl  String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

// Auditoría de acciones del admin (dar días, demo, suspender, responder soporte).
model AdminLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  targetUserId String?
  meta         Json?
  createdAt    DateTime @default(now())
}

// Pixel de Meta + token CAPI. Una entrada por evento (Lead / Purchase), como ScaleOS.
model Pixel {
  id          String   @id @default(cuid())
  userId      String
  pixelId     String
  capiToken   String
  eventType   String   // "Lead" | "Purchase"
  siteUrl     String?
  hidden      Boolean  @default(false) // sombra server-side: recibe copia de los eventos por CAPI pero
                                       // NO se lista/edita/borra desde el dashboard "Mi Pixel". Se carga a mano (SQL).
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

// Línea de WhatsApp (sesión Baileys/Evolution).
model WaLine {
  id          String    @id @default(cuid())
  userId      String
  phone       String    // ej: 5492944684573
  label       String?
  status      String    @default("inactive") // inactive | active | paused
  provider    String    @default("baileys")  // baileys (QR/Evolution) | cloud (WhatsApp Cloud API oficial)
  sessionId   String?   // id de sesión Baileys/Evolution
  connected   Boolean   @default(false)
  // --- Cloud API oficial (para anuncios Click-to-WhatsApp / CTWA) ---
  wabaPhoneNumberId String?  // Phone Number ID de la Cloud API
  wabaId      String?        // WhatsApp Business Account ID
  accessToken String?        // token de la Cloud API (cifrado en reposo)
  verifyToken String?        // token de verificación del webhook de Meta
  registerPin String?        // PIN de registro de la Cloud API (cifrado en reposo)
  registered  Boolean   @default(false) // true si el número quedó registrado en la Cloud API
  qualityRating String?      // Cloud API: GREEN | YELLOW | RED (calidad del número)
  lastCheckedAt DateTime?    // último chequeo de salud de la línea
  // --- Anti-ban (líneas Baileys) ---
  proxyUrl        String?    // proxy de salida por línea (URL completa, cifrada en reposo)
  warmupEnabled   Boolean   @default(false)  // rampa de calentamiento OFF por default (se activa por línea en Admin)
  warmupStartedAt DateTime?  // arranca al primer emparejamiento; se resetea si cambia el número
  // --- Proxies GESTIONADOS (pool admin) — OCULTO al cliente: estos campos NUNCA se exponen a un
  //     endpoint del cliente. Solo Baileys; las líneas Cloud API no usan proxy. Aditivo. ---
  proxyId           String?    // proxy del pool asignado a esta línea (relación a Proxy)
  proxySession      String?    // sesión sticky ÚNICA de esta línea (una IP fija por línea)
  proxyAssignedAt   DateTime?
  banned            Boolean    @default(false) // el NÚMERO quedó baneado (logout/ban del motor)
  lastProxyRotateAt DateTime?
  proxyWait         Boolean    @default(false) // "esperando proxy": sin proxy sano NO conecta (nunca por
                                               // la IP del VPS); un job la conecta cuando el pool vuelve
  expiresAt   DateTime? // se desactiva al vencer (consumo de días)
  lastUsedAt  DateTime? // para rotación LRU de clics entre líneas activas
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  proxy       Proxy?    @relation(fields: [proxyId], references: [id])
  contacts    Contact[]
  messages    Message[]

  @@index([sessionId]) // lookup por instancia en cada evento del webhook
  @@index([userId])
  @@index([proxyId])
}

// Pool de proxies de salida para líneas Baileys (anti-ban). GESTIÓN 100% ADMIN: las credenciales son
// SECRETAS — NINGÚN endpoint del cliente devuelve datos del proxy. `password` cifrada en reposo
// (lib/crypto.ts encryptSecret) y NUNCA se loguea en claro.
model Proxy {
  id          String    @id @default(cuid())
  label       String
  provider    String    @default("dataimpulse")
  host        String
  port        Int
  username    String
  password    String    // cifrada en reposo (encryptSecret) — NUNCA loguear ni exponer al cliente
  protocol    String    @default("http")   // http | socks5
  country     String?
  sticky      Boolean   @default(true)
  sessTime    Int       @default(120)       // duración de la sesión sticky (según el proveedor)
  maxLines    Int       @default(4)         // tope de líneas por IP/cuenta del proxy
  active      Boolean   @default(true)
  healthy     Boolean   @default(true)
  lastCheckAt DateTime?
  createdAt   DateTime  @default(now())
  lines       WaLine[]
}

// Auditoría del sistema de proxies (SOLO admin): asignaciones, rotaciones, caídas, baneos, salud.
// Sin FK a WaLine/Proxy a propósito: el evento sobrevive aunque se borre la línea o el proxy.
model ProxyEvent {
  id        String   @id @default(cuid())
  lineId    String
  proxyId   String?
  type      String   // assigned | rotated | line_down | reconnected | banned | proxy_unhealthy | unstable
  detail    String?
  createdAt DateTime @default(now())

  @@index([lineId])
  @@index([createdAt])
}

// Monitor de estabilidad de proxy (Fase 4, test IPRoyal). Un sample cada 5 min por línea de prueba:
// IP de salida por su proxy + estado de la sesión + errores + flaps (reconexiones desde el sample
// anterior). Con esto se mide en 24h cuántas veces cambia/cae la IP por línea. Aditivo, aislado.
model ProxyHealthSample {
  id           String   @id @default(cuid())
  lineId       String
  proxyId      String?
  ip           String?  // IP pública de salida vista por el proxy (null = no salió a internet)
  country      String?  // ISO2 (esperado AR)
  ipChanged    Boolean  @default(false) // la IP difiere del sample anterior
  sessionState String?  // WORKING | STARTING | SCAN_QR_CODE | FAILED | STOPPED | open | close | ...
  errorCode    String?  // none | disconnected | 515_restricted | probe_fail
  flaps        Int      @default(0)     // reconexiones contadas desde el sample anterior
  createdAt    DateTime @default(now())

  @@index([lineId, createdAt])
}

// Crédito prepago: "días disponibles" (1 día = 1 línea activa 24h).
model Credit {
  id        String   @id @default(cuid())
  userId    String   @unique
  days      Int      @default(0)
  user      User     @relation(fields: [userId], references: [id])
  ledger    CreditLedger[]
}

model CreditLedger {
  id        String   @id @default(cuid())
  creditId  String
  delta     Int      // +compra / -consumo
  reason    String
  createdAt DateTime @default(now())
  credit    Credit   @relation(fields: [creditId], references: [id])
}

// Contacto/lead con TODA la atribución. external_id es la clave del match con Meta.
model Contact {
  id          String   @id @default(cuid())
  userId      String
  externalId  String   @unique          // se envía a Meta (hasheado) para el match
  phone       String?
  waJid       String?                   // JID crudo de WhatsApp (soporta @lid) para responder
  name        String?
  source      String?                   // fb | ig | an | ...
  campaignId  String?                   // id de campaña de Meta
  adId        String?
  pixelId     String?
  fbp         String?                   // cookie _fbp
  fbc         String?                   // cookie _fbc (derivada de fbclid)
  fbclid      String?
  ctwaClid    String?                    // click id de anuncios Click-to-WhatsApp (referral de la Cloud API)
  code        String?                    // código corto incrustado en el msg de WA (único POR usuario, ver @@unique abajo)
  landingUrl  String?
  clientIp    String?                    // IP del visitante en la landing (sesión web original) — sube el EMQ del Purchase
  clientUserAgent String?                // user agent del visitante en la landing (va junto a la IP en el CAPI)
  lineId      String?
  stage       Stage    @default(NUEVO)
  amount      Int?                       // monto de la venta (en centavos o unidad menor)
  purchasedAt DateTime?
  paymentDetected     Boolean   @default(false) // detección de pago en chat (a confirmar)
  paymentDetectedAmount Int?                     // monto detectado (centavos), si la IA lo leyó
  paymentDetectedAt   DateTime?
  registeredAt        DateTime?  // registro completo (CompleteRegistration) enviado: auto (credenciales) o manual
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  line        WaLine?  @relation(fields: [lineId], references: [id])
  messages    Message[]
  flowRuns    FlowRun[]

  @@unique([userId, code]) // el código es único POR usuario (no global): dos clientes pueden generar el
                           // mismo `ref:` sin que el create explote (P2002) y se pierda el lead.
  @@index([userId, phone])  // match del contacto en cada mensaje entrante
  @@index([userId, stage])  // kanban / listados por etapa
}

enum Stage {
  NUEVO
  CONTACTADO
  INTERESADO
  COMPRO
  PERDIDO
}

// Mensajes del Inbox.
model Message {
  id         String   @id @default(cuid())
  contactId  String
  lineId     String
  direction  String   // in | out
  body       String
  status     String   @default("sent") // salientes: sent | delivered | read | failed (ack de WhatsApp)
  error      String?  // motivo si WhatsApp rechazó el envío (ej: código 463)
  mediaType  String?  // mimetype si el mensaje trae imagen (ej image/jpeg)
  mediaData  String?  @db.Text // imagen en base64 (sin prefijo data:) para mostrar en el Inbox
  waMessageId String?  @unique // idempotencia: no procesar dos veces el mismo evento de WhatsApp
  createdAt  DateTime @default(now())
  contact    Contact  @relation(fields: [contactId], references: [id])
  line       WaLine   @relation(fields: [lineId], references: [id])

  @@index([contactId, createdAt])          // historial de conversación
  @@index([lineId, direction, createdAt])  // cupo de warmup + heatmap por línea
}

// Landing alojada (S3/CloudFront), una o varias por usuario.
model Landing {
  id         String   @id @default(cuid())
  userId     String
  name       String
  slug       String   @unique
  html       String   @db.Text
  config     Json?                       // campos del editor (headline, msg, etc.) para re-editar
  isPrimary  Boolean  @default(false)
  published  Boolean  @default(false)
  publishedUrl String?          // URL de campaña (CloudFront del cliente) o local /p/:slug
  publishedAt  DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

// Integración con CRM externo (Fase 5): dispara webhooks por evento.
model Integration {
  id         String   @id @default(cuid())
  userId     String   @unique
  mode       String   @default("nativo") // nativo | webhook | kommo
  webhookUrl String?
  secret     String?                     // para firmar el payload (HMAC) saliente
  inboundToken String? @unique           // token del webhook ENTRANTE (Kommo → Publi.lat: marca compra + Purchase)
  onLead     Boolean  @default(true)
  onPurchase Boolean  @default(true)
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

// Pago de días/tokens (Fase 5). Real con pasarela (MercadoPago) o stub en dev.
model Payment {
  id         String   @id @default(cuid())
  userId     String
  provider   String                      // mercadopago | stub
  externalId String?                     // id de preferencia/pago en la pasarela
  days       Int
  amount     Int?                        // centavos
  currency   String   @default("ARS")
  status     String   @default("pending") // pending | approved | rejected
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

// Referido: comisión del 10% de la PRIMERA compra del referido, en USDT, pagada A MANO por el
// admin. Se crea al aprobarse el PRIMER pago del referido (ver lib/referrals.ts, enganchado en
// approvePayment). referredUserId es UNIQUE = una sola comisión por referido (primera compra).
// El monto se calcula sobre el valor en USD (días × usdPerDay) para no depender de la moneda.
model Referral {
  id                 String   @id @default(cuid())
  referrerId         String                        // quién refirió (User.id) — cobra la comisión
  referredUserId     String   @unique              // el referido: una comisión por referido
  paymentId          String?                        // el pago que la disparó
  days               Int      @default(0)           // días de esa primera compra
  amount             Int?                            // monto pagado (centavos, moneda original)
  currency           String   @default("USD")
  commissionUsdCents Int      @default(0)           // 10% del valor en USD, en centavos de USD
  status             String   @default("pending")   // pending | paid (el admin transfirió el USDT)
  paidAt             DateTime?
  paidNote           String?                          // hash/nota de la transferencia USDT
  createdAt          DateTime @default(now())
  referrer           User     @relation("ReferralReferrer", fields: [referrerId], references: [id])

  @@index([referrerId])
  @@index([status])
}

// ============================================================================
// Chat App — canal jugador↔cajero (módulo AISLADO). No comparte tablas con el
// Inbox de WhatsApp (Contact/Message/WaLine). userId = cuenta dueña (el operador).
// ============================================================================

// Jugador (usuario final del chat), registrado passwordless por un link de invitación.
model ChatPlayer {
  id              String   @id @default(cuid())
  userId          String   // cuenta dueña
  nombre          String?
  casinoUsername  String   // usuario del jugador en el casino
  password        String?  // hash bcrypt (null = jugador viejo passwordless; login sin clave)
  invitedByUserId String?  // operador que lo invitó (User.id)
  inviteCodeId    String?
  estatus         String   @default("active")
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations   ChatConversation[]
  pushSubs        ChatPushSub[]

  @@unique([userId, casinoUsername])
  @@index([userId])
}

// Conversación jugador↔cajero.
model ChatConversation {
  id                 String   @id @default(cuid())
  userId             String   // cuenta dueña
  playerId           String
  assignedOperatorId String?  // operador asignado (User.id)
  status             String   @default("open")
  unreadOperator     Int      @default(0)
  unreadPlayer       Int      @default(0)
  lastMessageAt      DateTime?
  lastMessagePreview String?
  botStep            String?  // estado del bot: null=menú | carga_monto | carga_pago | human (bot apagado)
  botAmount          Int?     // monto de carga pendiente (centavos)
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  player             ChatPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  messages           ChatMessage[]

  @@index([userId, status])
  @@index([playerId])
}

// Mensaje del chat (jugador / operador / sistema).
model ChatMessage {
  id             String   @id @default(cuid())
  userId         String   // cuenta dueña
  conversationId String
  senderType     String   // "player" | "operator" | "system"
  senderId       String?
  body           String?
  metadata       Json     @default("{}")
  readAt         DateTime?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Link de invitación single-use (un operador invita a un jugador).
model InviteCode {
  id         String   @id @default(cuid())
  userId     String   // cuenta dueña
  operatorId String   // operador que creó el link (User.id)
  code       String   @unique
  label      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, operatorId])
}

// Suscripción a Web Push de un jugador (para notificar mensajes con la PWA cerrada).
model ChatPushSub {
  id        String   @id @default(cuid())
  userId    String   // cuenta dueña
  playerId  String?
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  player    ChatPlayer? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([userId, endpoint])
  @@index([userId])
}

// Historial de avisos push enviados por el operador (para medir: cuántos, a quién, cuántos recibieron).
model ChatBroadcast {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  image     String?
  target    String   // "all" o el playerId al que se envió
  sentCount Int      @default(0) // a cuántas suscripciones se encoló
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Imágenes de branding del Chat App (logo, imagen de bienvenida) servidas por el PROPIO
// backend con URL corta y estable. Evita depender de un CDN público: el bucket S3 es privado
// y sin CloudFront la URL directa no carga. Para un logo por cuenta, bytea alcanza de sobra.
model BrandingAsset {
  id          String   @id @default(cuid())
  userId      String
  contentType String   // image/png | image/jpeg | image/webp | image/gif
  data        Bytes
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Log de eventos enviados a Meta (para auditoría y reintentos).
model MetaEvent {
  id         String   @id @default(cuid())
  userId     String
  contactId  String?
  eventName  String   // Lead | Purchase
  pixelId    String
  payload    Json
  status     String   @default("pending") // pending | sent | failed
  attempts   Int      @default(0)         // reintentos CAPI; tras el tope queda dead-letter
  response   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

// Tutoriales en video del panel (gestionados por el super-admin, visibles para TODOS los
// clientes en /tutoriales). El video NO se aloja acá: se guarda la URL (YouTube/Vimeo/mp4) y
// el front arma el embed. Global (sin userId): un solo set de tutoriales para toda la plataforma.
model Tutorial {
  id          String   @id @default(cuid())
  title       String
  description String?
  videoUrl    String   // link de YouTube/Vimeo o un .mp4 directo
  order       Int      @default(0) // orden de aparición (menor primero)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}
